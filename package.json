{
  "name": "woho-browser",
  "version": "0.1.0",
  "private": true,
  "description": "WoHo Browser — Windows-first Electron/Chromium browser prototype",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "lint": "eslint .",
    "test:web": "node --test web/tests/bookmarks.node-test.mjs web/tests/security.node-test.mjs",
    "build:web": "node web/scripts/build.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.3",
    "typescript-eslint": "^8.57.0"
  },
  "build": {
    "appId": "in.wohotech.browser",
    "productName": "WoHo Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/index.html",
      "out/renderer/assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "overrides": {
    "@electron/get": "5.1.0"
  }
}
